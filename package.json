{
  "name": "snapyos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "node tests/e2e/run.mjs all",
    "test:e2e:kiosk": "node tests/e2e/run.mjs kiosk",
    "test:e2e:bluetooth": "node tests/e2e/run.mjs bluetooth",
    "test:e2e:bluetooth:real": "node tests/e2e/kiosk-print-bluetooth-real.spec.mjs",
    "test:e2e:print": "node tests/e2e/run.mjs standalone",
    "bridge:local": "node scripts/photobooth-bridge.mjs",
    "bridge:gphoto2": "node scripts/photobooth-bridge.mjs",
    "clean": "find . -name '._*' -not -path './node_modules/*' -delete",
    "predev": "npm run clean",
    "prebuild": "npm run clean"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@base-ui/react": "^1.7.0",
    "@node-rs/argon2": "^2.1.0",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "exceljs": "^4.4.0",
    "gifenc": "^1.0.3",
    "jpeg-js": "^0.4.4",
    "lucide-react": "^1.31.0",
    "motion": "^14.0.0",
    "next": "^16.3.8",
    "next-auth": "5.0.0-beta.32",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "recharts": "^3.8.0",
    "resend": "^6.31.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jpeg-js": "^0.3.0",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "playwright": "^1.64.0",
    "prettier": "^3.9.6",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "npm@12.0.2"
}
