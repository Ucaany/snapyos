{
  "name": "snapyos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env.local .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test": "node --test --experimental-strip-types runtime/print/index.test.ts runtime/print/geometry.test.ts runtime/print/jobs.test.ts runtime/camera/gphoto2.test.ts src/lib/print-layout.test.ts src/lib/branding-merge.test.ts src/lib/branding-reset.test.ts src/lib/kiosk-capture.test.ts src/lib/rate-limit.test.ts src/lib/auth-tokens.test.ts src/lib/payment-credentials.test.ts src/lib/booth-health.test.ts src/lib/subscription-math.test.ts scripts/sync-gphoto2-cameras.test.mjs",
    "sync:cameras": "node scripts/sync-gphoto2-cameras.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bridge:local": "node --env-file-if-exists=.env.bridge scripts/photobooth-bridge.mjs",
    "bridge:gphoto2": "node --env-file-if-exists=.env.bridge scripts/photobooth-bridge.mjs",
    "clean": "find . -name '._*' -not -path './node_modules/*' -delete",
    "predev": "npm run clean",
    "prebuild": "npm run clean"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^7.0.6",
    "@node-rs/argon2": "^2.1.0",
    "@shadcn/react": "^0.3.1",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "cobe": "^2.0.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "gifenc": "^1.0.3",
    "input-otp": "^1.5.0",
    "jpeg-js": "^0.4.4",
    "lucide-react": "^1.31.0",
    "motion": "^14.0.0",
    "next": "^16.4.2",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.92.0",
    "react-resizable-panels": "^4.22.0",
    "recharts": "^3.8.0",
    "resend": "^6.31.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/jpeg-js": "^0.3.0",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "prettier": "^3.9.6",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "npm@12.0.2"
}
