<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SnapyOS.Booth.Shell</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Fase 1: unpackaged + Windows App SDK self-contained supaya `dotnet build`
         lalu jalankan EXE langsung bekerja tanpa memasang runtime. Fase 5
         mengganti ke MSIX (WindowsPackageType=MSIX) + code signing. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>

  <!--
    MRT/PRI dimatikan untuk build CLI.

    WindowsAppSDK memakai task `Microsoft.Build.Packaging.Pri.Tasks` yang HANYA
    dikirim bersama Visual Studio (workload UWP). Runner `windows-latest` maupun
    mesin operator dengan .NET SDK saja tidak punya assembly itu, sehingga build
    gagal MSB4062 di MrtCore.PriGen.targets.

    Aman untuk aplikasi ini: tidak ada `.resw` maupun aset `ms-appx` — UI dilayani
    dari folder lewat SetVirtualHostNameToFolderMapping, dan XAML ter-compile jadi
    XBF di dalam assembly. Resource framework WinUI tetap tersalin karena
    Microsoft.WindowsAppSDK.SelfContained.targets menyalin setiap `*.pri` dari
    MSIX runtime (hanya `resources.pri` gabungan yang memang dibuang di sana).

    Fase 5 (MSIX di mesin ber-Visual Studio) bisa mengembalikannya dengan
    `-p:EnableCoreMrtTooling=true`.
  -->
  <PropertyGroup>
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.240923002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SnapyOS.Booth.Bridge\SnapyOS.Booth.Bridge.csproj" />
    <ProjectReference Include="..\SnapyOS.Booth.Core\SnapyOS.Booth.Core.csproj" />
  </ItemGroup>

  <!-- UI React hasil build (booth/ui) disalin ke Assets/ui dan dipetakan ke
       https://snapyos.app/ lewat SetVirtualHostNameToFolderMapping. -->
  <ItemGroup>
    <Content Include="Assets\ui\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Peluncur satu klik ikut ke folder publish, jadi ZIP rilis bisa dipakai
         operator tanpa PowerShell manual. -->
    <Content Include="..\..\scripts\Jalankan-Booth.cmd"
             Link="Jalankan-Booth.cmd"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Ikon di-generate, bukan di-commit (booth/.gitignore). Tanpa target ini
       clone bersih dan runner CI gagal di CoreCompile karena Assets\app.ico
       belum ada (CS7064). Node sudah jadi prasyarat build lewat BuildUi. -->
  <Target Name="GenerateAssets" BeforeTargets="BeforeBuild"
          Condition="!Exists('$(MSBuildProjectDirectory)\Assets\app.ico')">
    <Exec Command="node &quot;$(MSBuildProjectDirectory)\..\..\scripts\generate-assets.mjs&quot;" />
  </Target>

  <!-- UI dibangun lebih dulu supaya Assets/ui selalu segar. Lewati dengan
       -p:SkipUiBuild=true bila UI sudah dibangun terpisah. -->
  <Target Name="BuildUi" BeforeTargets="BeforeBuild" Condition="'$(SkipUiBuild)' != 'true'">
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)\..\..\ui" Condition="!Exists('$(MSBuildProjectDirectory)\..\..\ui\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)\..\..\ui" />
  </Target>

</Project>
