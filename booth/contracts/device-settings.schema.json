{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snapyos.biz.id/contracts/device-settings.schema.json",
  "title": "SnapyOSDeviceSettings",
  "description": "Kontrak setelan device SnapyOS — satu sumber kebenaran untuk cloud (TS) dan aplikasi booth (C#). Grup setelan dan kepemilikannya dibaca kedua sisi dari berkas ini lewat generator (booth/contracts/generate.mjs).",
  "type": "object",
  "additionalProperties": false,
  "x-snapyos-schema-version": 1,
  "x-snapyos-groups": ["camera_settings", "print_settings", "session_settings", "appearance_settings"],
  "x-snapyos-cloud-synced-groups": ["camera_settings", "print_settings", "session_settings"],
  "x-snapyos-local-only-groups": ["appearance_settings"],
  "x-snapyos-cloud-owned-fields": {
    "camera_settings": [],
    "print_settings": ["copies", "layout"],
    "session_settings": [],
    "appearance_settings": []
  },
  "x-snapyos-secret-key-prefix": "exit_pin_",
  "properties": {
    "camera_settings": {
      "$ref": "#/$defs/cameraSettings"
    },
    "print_settings": {
      "$ref": "#/$defs/printSettings"
    },
    "session_settings": {
      "$ref": "#/$defs/sessionSettings"
    },
    "appearance_settings": {
      "$ref": "#/$defs/appearanceSettings"
    }
  },
  "$defs": {
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "description": "Warna hex #RRGGBB."
    },
    "pageAlign": {
      "type": "string",
      "enum": ["left", "center", "right"]
    },
    "cameraProvider": {
      "type": "string",
      "enum": ["browser", "bridge", "gphoto2", "digicamcontrol", "libcamera", "v4l2", "pyav"]
    },
    "printMode": {
      "type": "string",
      "enum": ["browser", "bluetooth", "cups"]
    },
    "appearancePage": {
      "type": "object",
      "additionalProperties": false,
      "x-snapyos-owner": "device",
      "properties": {
        "bg_color": { "$ref": "#/$defs/hexColor" },
        "text_color": { "$ref": "#/$defs/hexColor" },
        "font_scale": { "type": "number", "minimum": 0.8, "maximum": 1.4 },
        "button_radius": { "type": "integer", "minimum": 0, "maximum": 24 },
        "padding": { "type": "integer", "minimum": 0, "maximum": 96 },
        "align": { "$ref": "#/$defs/pageAlign" }
      }
    },
    "appearancePages": {
      "type": "object",
      "additionalProperties": false,
      "x-snapyos-owner": "device",
      "properties": {
        "welcome": { "$ref": "#/$defs/appearancePage" },
        "guide": { "$ref": "#/$defs/appearancePage" },
        "package": { "$ref": "#/$defs/appearancePage" },
        "payment": { "$ref": "#/$defs/appearancePage" },
        "template": { "$ref": "#/$defs/appearancePage" },
        "capture": { "$ref": "#/$defs/appearancePage" },
        "edit": { "$ref": "#/$defs/appearancePage" },
        "result": { "$ref": "#/$defs/appearancePage" }
      }
    },
    "cameraSettings": {
      "type": "object",
      "additionalProperties": false,
      "x-snapyos-owner": "device",
      "properties": {
        "provider": { "$ref": "#/$defs/cameraProvider" },
        "bridge_url": { "type": "string", "format": "uri", "maxLength": 300 },
        "countdown_seconds": { "type": "integer", "minimum": 1, "maximum": 10 },
        "mirror_preview": { "type": "boolean" },
        "chroma_key_enabled": { "type": "boolean" },
        "fullscreen": { "type": "boolean" },
        "facingMode": {
          "anyOf": [{ "type": "string", "enum": ["user", "environment"] }, { "type": "null" }]
        },
        "preferred_device_id": { "anyOf": [{ "type": "string", "maxLength": 200 }, { "type": "null" }] },
        "capture_width": { "type": "integer", "minimum": 640, "maximum": 7680 },
        "capture_height": { "type": "integer", "minimum": 480, "maximum": 4320 },
        "jpeg_quality": { "type": "number", "minimum": 0.5, "maximum": 1 },
        "rotation_degrees": { "type": "integer", "minimum": 0, "maximum": 270 },
        "zoom": { "type": "number", "minimum": 1, "maximum": 5 },
        "screen_orientation": { "type": "string", "enum": ["landscape", "portrait"] }
      }
    },
    "printSettings": {
      "type": "object",
      "additionalProperties": false,
      "x-snapyos-owner": "device",
      "properties": {
        "enabled": { "type": "boolean" },
        "paper_size": { "type": "string", "enum": ["4x6", "A6"] },
        "layout": { "type": "string", "enum": ["single", "strip"], "x-snapyos-owner": "cloud" },
        "orientation": { "type": "string", "enum": ["portrait", "landscape"] },
        "auto_print": { "type": "boolean" },
        "copies": { "type": "integer", "minimum": 1, "maximum": 20, "x-snapyos-owner": "cloud" },
        "margins_mm": { "type": "integer", "minimum": 0, "maximum": 20 },
        "mode": { "$ref": "#/$defs/printMode" },
        "bluetooth_paper_width_mm": { "type": "integer", "enum": [58, 80] },
        "bluetooth_device_name": { "type": "string", "maxLength": 60 },
        "bridge_url": { "type": "string", "format": "uri", "maxLength": 300 },
        "printer_name": { "type": "string", "maxLength": 128 }
      }
    },
    "sessionSettings": {
      "type": "object",
      "additionalProperties": false,
      "x-snapyos-owner": "device",
      "x-snapyos-invariants": ["warning_seconds < timer_seconds"],
      "properties": {
        "timer_seconds": { "type": "integer", "minimum": 60, "maximum": 3600 },
        "warning_seconds": { "type": "integer", "minimum": 10, "maximum": 600 },
        "max_retakes": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 50 }, { "type": "null" }] }
      }
    },
    "appearanceSettings": {
      "type": "object",
      "additionalProperties": false,
      "x-snapyos-owner": "device",
      "x-snapyos-local-only": true,
      "properties": {
        "bg_color": { "$ref": "#/$defs/hexColor" },
        "text_color": { "$ref": "#/$defs/hexColor" },
        "font_family": { "type": "string", "enum": ["display", "sans", "mono"] },
        "font_scale": { "type": "number", "minimum": 0.8, "maximum": 1.4 },
        "button_radius": { "type": "integer", "minimum": 0, "maximum": 24 },
        "padding": { "type": "integer", "minimum": 0, "maximum": 96 },
        "align": { "$ref": "#/$defs/pageAlign" },
        "welcome_layout": { "type": "string", "enum": ["split-left", "split-right", "center"] },
        "result_layout": { "type": "string", "enum": ["qr-right", "qr-left", "qr-below"] },
        "welcome_title": { "type": "string", "maxLength": 120 },
        "welcome_tagline": { "type": "string", "maxLength": 200 },
        "welcome_button": { "type": "string", "minLength": 1, "maxLength": 24 },
        "payment_title": { "type": "string", "maxLength": 80 },
        "payment_hint": { "type": "string", "maxLength": 160 },
        "capture_title": { "type": "string", "maxLength": 80 },
        "capture_hint": { "type": "string", "maxLength": 160 },
        "editor_title": { "type": "string", "maxLength": 80 },
        "editor_hint": { "type": "string", "maxLength": 160 },
        "result_title": { "type": "string", "maxLength": 80 },
        "result_hint": { "type": "string", "maxLength": 160 },
        "guide_title": { "type": "string", "maxLength": 80 },
        "guide_button": { "type": "string", "minLength": 1, "maxLength": 24 },
        "package_title": { "type": "string", "maxLength": 80 },
        "template_title": { "type": "string", "maxLength": 80 },
        "show_logo": { "type": "boolean" },
        "show_tagline": { "type": "boolean" },
        "show_mirror_toggle": { "type": "boolean" },
        "allow_zoom_pan": { "type": "boolean" },
        "guide_steps": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "pages": { "$ref": "#/$defs/appearancePages" }
      }
    }
  }
}
