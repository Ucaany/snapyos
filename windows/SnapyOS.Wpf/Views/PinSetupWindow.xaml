<Window x:Class="SnapyOS.Wpf.Views.PinSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapyOS — Atur PIN Awal"
        WindowStartupLocation="CenterScreen"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        Background="#FFFDF5" Foreground="#111111">
  <StackPanel Margin="32">
    <TextBlock Text="ATUR PIN AWAL" FontSize="24" FontWeight="Black" />
    <TextBlock Margin="0,8,0,20" TextWrapping="Wrap"
               Text="PIN ini wajib diatur sekali sebelum kiosk berjalan. Gunakan 4-6 digit dan ketiga PIN harus berbeda." />

    <TextBlock Text="PIN Admin" FontWeight="Bold" />
    <PasswordBox x:Name="AdminPin" MinHeight="40" Margin="0,4,0,12" AutomationProperties.Name="PIN admin" MaxLength="6" />

    <TextBlock Text="PIN Keluar Kiosk" FontWeight="Bold" />
    <PasswordBox x:Name="ExitPin" MinHeight="40" Margin="0,4,0,12" AutomationProperties.Name="PIN keluar kiosk" MaxLength="6" />

    <TextBlock Text="PIN Darurat Offline" FontWeight="Bold" />
    <PasswordBox x:Name="EmergencyPin" MinHeight="40" Margin="0,4,0,12" AutomationProperties.Name="PIN darurat offline" MaxLength="6" />

    <TextBlock x:Name="ErrorText" Foreground="#B00020" TextWrapping="Wrap" Margin="0,0,0,12" />
    <Button Content="Simpan dan Mulai Kiosk" Click="Save_OnClick" MinHeight="48" FontSize="16" FontWeight="Bold" />
  </StackPanel>
</Window>