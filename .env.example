# ============================================================================
# SnapyOS: template environment.
#
# Dev:    cp .env.example .env.local
# VPS:    cp .env.example /var/www/snapyos/.env.production  (systemd EnvironmentFile)
#
# Nilai di bawah hanya placeholder. Jangan pernah meng-commit file .env asli.
# ============================================================================

# --- Supabase (PostgreSQL + Storage) ---
# Dashboard Supabase → Project Settings → API. Service role hanya untuk server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# --- Auth.js v5 (NextAuth) ---
# Generate: openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32
# Origin publik HTTPS. Dipakai untuk redirect callback dan CORS R2.
AUTH_URL=https://test.snapyos.biz.id
# Origin publik yang ditampilkan di UI (webhook URL merchant langsung).
SnapyOS_PUBLIC_BASE_URL=https://test.snapyos.biz.id

# --- Tripay platform (invoice subscription SnapyOS) ---
# Credential merchant platform, BUKAN credential tenant. Dipakai hanya untuk
# menagih invoice langganan (dana → akun Tripay SnapyOS). Environment mengikuti
# PAYMENT_GATEWAY_ENV (atau NODE_ENV).
# Produksi: SnapyOS_PUBLIC_BASE_URL=https://snapyos.site
# Callback Tripay: https://snapyos.site/api/webhooks/payment/tripay
TRIPAY_MERCHANT_CODE=
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=

# --- Enkripsi kredensial pembayaran (direct merchant) ---
# AES-256-GCM. Generate: openssl rand -hex 32. Jangan samakan dengan AUTH_SECRET.
PAYMENT_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
# Rotasi kunci: payload baru selalu ditulis v2 bila ini diisi; v1 tetap bisa
# didekripsi selama PAYMENT_ENCRYPTION_KEY masih ada. Kosong = tetap v1.
PAYMENT_ENCRYPTION_KEY_V2=
# "production" | "sandbox". Kosong = diturunkan dari NODE_ENV.
PAYMENT_GATEWAY_ENV=

# --- Cloudflare (panel admin: traffic edge + WAF/bot) ---
# Token API dengan izin Zone > Analytics > Read untuk zone di bawah.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Opsional, hanya untuk `node scripts/cloudflare-check.mjs`: resolusi Zone ID dari nama.
CLOUDFLARE_ZONE_NAME=

# --- Admin platform ---
# Email admin, pisahkan dengan koma.
ADMIN_EMAILS=admin@example.com

# --- Cron ---
# Bearer token untuk /api/cron/*. Generate: openssl rand -hex 32.
# Placeholder berawalan "change-me" sengaja ditolak route cron, jadi cron tidak
# pernah jalan dengan nilai template.
CRON_SECRET=change-me-openssl-rand-hex-32
# Flag dev-only. Di production semuanya harus kosong.
RETENTION_CRON_OPEN=
SUBSCRIPTION_CRON_OPEN=
PAYMENT_RECOVERY_CRON_OPEN=
DEVICE_CLEANUP_CRON_OPEN=
RECONCILE_STORAGE_CRON_OPEN=
ORPHAN_SWEEP_CRON_OPEN=
# Sweep objek yatim hanya melapor (tanpa hapus). Production: kosong.
ORPHAN_SWEEP_DRY_RUN=

# --- CAPTCHA (Cloudflare Turnstile) ---
# Site key publik, secret server-side. Di production keduanya wajib.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Hostname yang diizinkan, pisahkan dengan koma. Wajib di production.
TURNSTILE_ALLOWED_HOSTNAMES=test.snapyos.biz.id

# --- Dev flags ---
# true = lewati pembayaran. WAJIB false di production.
DEV_SKIP_PAYMENT=false

# --- Email (Resend) ---
RESEND_API_KEY=replace-with-resend-api-key
# Alamat pengirim terverifikasi, mis. "SnapyOS <noreply@snapyos.biz.id>".
RESEND_FROM=

# --- Emoji API (picker kiosk) ---
EMOJI_API_KEY=

# --- Storage provider ---
# "r2" | "supabase". Kosong = R2 bila kredensial lengkap, selain itu Supabase.
STORAGE_WRITE_PROVIDER=
# Legacy; nilai "r2" tetap dihormati.
STORAGE_PROVIDER=

# --- Cloudflare R2 (server-only, bucket privat) ---
# Dashboard Cloudflare → R2 → Manage R2 API Tokens (Object Read & Write).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_BUSINESS_ASSETS=
R2_BUCKET_GENERATED_PHOTOS=
# Opsional; fallback satu bucket untuk semua area.
R2_BUCKET=
# Opsional; default https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# --- Tooling (bukan runtime app) ---
# Dipakai scripts/verify-migration-rollbacks.mjs; WAJIB database scratch.
MIGRATION_CHECK_DB=

# --- Local bridge (kamera + printer) ---
# Hanya dipakai runtime lokal (scripts/photobooth-bridge.mjs → runtime/main.ts),
# bukan proses Next.js. Nilai di bawah dijalankan di komputer kiosk, bukan di
# server cloud.
# Default 127.0.0.1:17777. Jangan ubah host ke 0.0.0.0 tanpa jaringan tepercaya:
# bridge memicu shutter dan mencetak.
PHOTOBOOTH_BRIDGE_HOST=127.0.0.1
PHOTOBOOTH_BRIDGE_PORT=17777
# Origin kiosk yang diizinkan, pisahkan dengan koma.
PHOTOBOOTH_BRIDGE_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# WAJIB, minimal 16 karakter. Bridge menolak start tanpa ini.
# Generate: node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
# Nilai yang sama diisi di Setup Perangkat → Token bridge.
PHOTOBOOTH_BRIDGE_TOKEN=
# Adapter perangkat. Kosong = default runtime
# Kamera: digicamcontrol | gphoto2 | libcamera | v4l2 | pyav | mock
# Printer: windows | cups | mock
SNAPYOS_CAMERA=
# SNAPYOS_CAMERA_STREAM: adapter preview terpisah; kosong = pakai kamera stills;
# nilai sama dengan SNAPYOS_CAMERA.
SNAPYOS_PRINTER=
# Mock menolak jalan bila NODE_ENV=production kecuali ini diisi 1.
SNAPYOS_ALLOW_MOCK=
# DB + media + karantina. Kosong = ~/.snapyos. Jangan arahkan ke folder kode.
SNAPYOS_DATA_DIR=
# Sync ke cloud (opsional). Kosong = sesi hanya tersimpan lokal, tidak dikirim.
# SNAPYOS_CLOUD_URL = origin cloud, mis. https://app.snapyos.id
# SNAPYOS_DEVICE_TOKEN = token dari aktivasi booth
SNAPYOS_CLOUD_URL=
SNAPYOS_DEVICE_TOKEN=
# --- digiCamControl (kamera DSLR, opsional) ---
# Web server bawaan digiCamControl.
DIGICAMCONTROL_PORT=5513
DIGICAMCONTROL_CMD=
GPHOTO2_BIN=gphoto2
# Opsional, mis. "usb:001,004" bila ada lebih dari satu kamera.
GPHOTO2_CAPTURE_TARGET=
# Batas tunggu capture; minimum 5000.
GPHOTO2_TIMEOUT_MS=45000
LP_BIN=lp
LPSTAT_BIN=lpstat

# ============================================================================
# Variabel E2E di tests/e2e/* hanya untuk harness lokal (E2E_BASE, E2E_FULL,
# HEADED, dst.) dan sengaja tidak dicantumkan di sini.
# ============================================================================
