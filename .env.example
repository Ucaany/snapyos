# ============================================================================
# SnapyOS — Environment variables (copy to .env.local, isi nilai asli)
# JANGAN commit .env.local — sudah di-ignore oleh .gitignore.
# ============================================================================

# --- Supabase (PostgreSQL + Storage + Realtime) ---
# Dashboard Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth.js v5 (NextAuth) ---
# Generate secret: npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Public HTTPS origin used only to display direct-merchant callback URLs.
# Required before owner UI enables callback-copy; never use a localhost/non-HTTPS URL.
SnapyOS_PUBLIC_BASE_URL=https://example.com

# --- Pakasir (Payment Gateway — https://pakasir.com/p/docs, API v2) ---
PAKASIR_API_KEY=
PAKASIR_PROJECT_SLUG=
# Webhook secret v2 — ambil/reset di halaman Detail Proyek Pakasir bagian bawah.
PAKASIR_WEBHOOK_SECRET=
# URL webhook yang didaftarkan manual di pengaturan proyek Pakasir.
# TIDAK dibaca kode: URL yang ditampilkan ke owner dibangun dari
# SnapyOS_PUBLIC_BASE_URL (paymentWebhookUrl()). Isi agar operator punya
# satu sumber nilai yang sama dengan yang didaftarkan di dashboard Pakasir.
PAKASIR_WEBHOOK_URL=https://example.com/api/webhooks/payment/pakasir
# Opsional; default https://app.pakasir.com (base tanpa /api).
PAKASIR_BASE_URL=

# --- Payment Credential Encryption (Direct Merchant — Phase 1+) ---
# AES-256-GCM key untuk encrypt server_key_encrypted di payment_credentials.
# WAJIB jika fitur direct merchant diaktifkan. Generate: openssl rand -hex 32
# JANGAN gunakan AUTH_SECRET — security boundary terpisah.
PAYMENT_ENCRYPTION_KEY=
# Override environment gateway payment ('' = sandbox kecuali production).
# "production" | "sandbox". Kosong = turunkan dari NODE_ENV.
PAYMENT_GATEWAY_ENV=

# --- Admin (CEO / pemilik SnapyOS) ---
# Daftar email (pisahkan koma) yang otomatis role=admin.
# Cara lain membuat admin pertama (install fresh): jalankan migration
# db/migrations/0052_admin_bootstrap.sql (auto-promosi user paling awal bila
# belum ada admin), atau `node scripts/bootstrap-admin.mjs <email>`.
ADMIN_EMAILS=ceo@snapyos.biz.id

# --- Cron retention (docs/12 Phase 11) ---
# Bearer token untuk /api/cron/retention (cron harian vercel.json).
# Wajib diisi di production; kosong = cron hanya jalan di luar production.
# Generate: openssl rand -hex 32
CRON_SECRET=change-me-generate-with-openssl-rand-hex-32

# --- Rate limiting (src/lib/rate-limit.ts) ---
# Fixed-window per-IP dipanggil di dalam handler (bukan middleware): login/auth,
# route publik kiosk (checkout, payments, sessions), webhook, contact/subscribe.
#
# Backend opsional shared (Upstash Redis REST). Kosong = fallback in-memory
# (per-instance; cukup dev/test/instance tunggal). Isi KEDUANYA di production
# multi-instance agar counter shared lintas instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- CAPTCHA (Cloudflare Turnstile — https://dash.cloudflare.com → Turnstile) ---
# Widget di /login, buat booth, checkout & voucher kiosk. Kosong = verifikasi
# DILEWATI di non-production; di production tanpa secret → SEMUA request
# ter-gate DITOLAK (fail-closed). Site key = public (aman di bundle client).
# Widget mengirim token ke https://challenges.cloudflare.com (sudah diizinkan
# CSP di next.config.ts: script-src + frame-src challenges.cloudflare.com).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Hostname valid dari response Turnstile, dipisahkan koma. Wajib di production.
TURNSTILE_ALLOWED_HOSTNAMES=

# --- Dev flags ---
# Bypass payment (sesi langsung dari package tanpa QRIS) — HANYA untuk dev/test.
# false = alur pay-first penuh (checkout → QRIS → paid → sesi).
DEV_SKIP_PAYMENT=false
# Buka akses cron retention tanpa CRON_SECRET (dev-only, DILARANG di production).
RETENTION_CRON_OPEN=
# Buka akses cron subscription (lifecycle + expiry-reminder) tanpa CRON_SECRET
# (dev-only, fail-closed di production).
SUBSCRIPTION_CRON_OPEN=
# Buka akses cron payment-recovery tanpa CRON_SECRET (dev-only, fail-closed di production).
PAYMENT_RECOVERY_CRON_OPEN=

# --- Email (Resend — broadcast marketing/pengumuman admin) ---
# API key dari resend.com (https://resend.com/api-keys). Wajib untuk kirim email.
RESEND_API_KEY=
# Alamat pengirim terverifikasi (mis. "SnapyOS <noreply@snapyos.biz.id>"). Wajib di production;
# kosong = fallback onboarding@resend.dev (test only).
RESEND_FROM=

# --- Emoji API (emoji-api.com — sticker/emoji picker kiosk) ---
# Server-side proxy; key tidak diekspos ke client.
EMOJI_API_KEY=

# ============================================================================
# Storage provider — Phase 3 (dual-storage, src/server/storage)
# ============================================================================
# STORAGE_WRITE_PROVIDER = provider untuk UPLOAD BARU.
#   "r2" | "supabase". Bila kosong: default R2 HANYA bila env R2 lengkap;
#   bila R2 belum dikonfigurasi, otomatis turun ke Supabase (anti-outage).
# STORAGE_PROVIDER = legacy (Fase 2); nilai "r2" dihormati. Baca objek lama
#   selalu fallback ke Supabase via resolusi per-objek, tanpa ubah key/DB.
STORAGE_PROVIDER=
STORAGE_WRITE_PROVIDER=

# ============================================================================
# Cloudflare R2 (S3-compatible) — server-only, PRIVATE bucket
# ============================================================================
# Flow media memakai R2 sebagai provider WRITE default (bila env lengkap);
# objek lama tetap di Supabase (dual-storage). JANGAN isi NEXT_PUBLIC_* untuk
# R2 — kredensial wajib tetap server-only (lihat src/lib/r2/config.ts).
# DUA bucket privat terpisah, satu per area (key DB dipakai apa adanya):
#   business-assets  → R2_BUCKET_BUSINESS_ASSETS
#   generated-photos → R2_BUCKET_GENERATED_PHOTOS
# Dashboard Cloudflare → R2 → Manage R2 API Tokens (Object Read & Write).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Nama bucket R2 per area (privat; bukan nama bucket Supabase).
R2_BUCKET_BUSINESS_ASSETS=
R2_BUCKET_GENERATED_PHOTOS=
# Legacy/opsional: satu bucket untuk semua area (fallback bila per-area kosong).
R2_BUCKET=
# Opsional; default diturunkan dari account id:
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Setelah kredensial R2 terisi, pasang CORS bucket sekali per environment
# (WAJIB untuk render frame di canvas; origin diambil dari AUTH_URL +
# SnapyOS_PUBLIC_BASE_URL):
#   node scripts/configure-r2-cors.mjs
