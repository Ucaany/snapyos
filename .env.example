# ============================================================================
# SnapyOS: template environment.
#
# Dev:    cp .env.example .env.local
# VPS:    cp .env.example /var/www/snapyos/.env.production  (systemd EnvironmentFile)
#
# Nilai di bawah hanya placeholder. Jangan pernah meng-commit file .env asli.
# ============================================================================

# --- Supabase (PostgreSQL + Storage) ---
# Dashboard Supabase → Project Settings → API. Service role hanya untuk server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# --- Auth.js v5 (NextAuth) ---
# Generate: openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32
# Origin publik HTTPS. Dipakai untuk redirect callback dan CORS R2.
AUTH_URL=https://test.snapyos.biz.id
# Origin publik yang ditampilkan di UI (webhook URL merchant langsung).
SnapyOS_PUBLIC_BASE_URL=https://test.snapyos.biz.id

# --- Pakasir (payment gateway) ---
PAKASIR_API_KEY=replace-with-pakasir-api-key
PAKASIR_PROJECT_SLUG=replace-with-project-slug
# Webhook secret v2 dari halaman Detail Proyek Pakasir.
PAKASIR_WEBHOOK_SECRET=replace-with-pakasir-webhook-secret
# Opsional; default https://app.pakasir.com (tanpa /api).
PAKASIR_BASE_URL=

# --- Enkripsi kredensial pembayaran (direct merchant) ---
# AES-256-GCM. Generate: openssl rand -hex 32. Jangan samakan dengan AUTH_SECRET.
PAYMENT_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
# "production" | "sandbox". Kosong = diturunkan dari NODE_ENV.
PAYMENT_GATEWAY_ENV=

# --- Admin platform ---
# Email admin, pisahkan dengan koma.
ADMIN_EMAILS=admin@example.com

# --- Cron ---
# Bearer token untuk /api/cron/*. Generate: openssl rand -hex 32.
# Placeholder berawalan "change-me" sengaja ditolak route cron, jadi cron tidak
# pernah jalan dengan nilai template.
CRON_SECRET=change-me-openssl-rand-hex-32
# Flag dev-only. Di production semuanya harus kosong.
RETENTION_CRON_OPEN=
SUBSCRIPTION_CRON_OPEN=
PAYMENT_RECOVERY_CRON_OPEN=
DEVICE_CLEANUP_CRON_OPEN=

# --- Rate limiting ---
# In-memory per proses (src/lib/rate-limit.ts). Tidak ada env yang dibutuhkan.

# --- CAPTCHA (Cloudflare Turnstile) ---
# Site key publik, secret server-side. Di production keduanya wajib.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Hostname yang diizinkan, pisahkan dengan koma. Wajib di production.
TURNSTILE_ALLOWED_HOSTNAMES=test.snapyos.biz.id

# --- Dev flags ---
# true = lewati pembayaran. WAJIB false di production.
DEV_SKIP_PAYMENT=false

# --- Email (Resend) ---
RESEND_API_KEY=replace-with-resend-api-key
# Alamat pengirim terverifikasi, mis. "SnapyOS <noreply@snapyos.biz.id>".
RESEND_FROM=

# --- Emoji API (picker kiosk) ---
EMOJI_API_KEY=

# --- Storage provider ---
# "r2" | "supabase". Kosong = R2 bila kredensial lengkap, selain itu Supabase.
STORAGE_WRITE_PROVIDER=
# Legacy; nilai "r2" tetap dihormati.
STORAGE_PROVIDER=

# --- Cloudflare R2 (server-only, bucket privat) ---
# Dashboard Cloudflare → R2 → Manage R2 API Tokens (Object Read & Write).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_BUSINESS_ASSETS=
R2_BUCKET_GENERATED_PHOTOS=
# Opsional; fallback satu bucket untuk semua area.
R2_BUCKET=
# Opsional; default https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# --- Tooling (bukan runtime app) ---
# Dipakai scripts/verify-migration-rollbacks.mjs; WAJIB database scratch.
MIGRATION_CHECK_DB=

# ============================================================================
# Variabel E2E di tests/e2e/* hanya untuk harness lokal (E2E_BASE, E2E_FULL,
# HEADED, dst.) dan sengaja tidak dicantumkan di sini.
# ============================================================================
